#!/bin/bash
# dynamic-wallpaper — pick the wallpaper that matches the time of day.
# Usage: dynamic-wallpaper [folder]
# The folder may be an absolute path or a name under ~/.config/omarchy/backgrounds.

set -euo pipefail

DEFAULT_SET="${DYNAMIC_WALLPAPER_SET:-dynamic}"
REQUESTED="${1:-$DEFAULT_SET}"
TRANSITION_MINUTES="${DYNAMIC_WALLPAPER_TRANSITION_MINUTES:-5}"

if [[ "$REQUESTED" == /* ]]; then
  WALLPAPER_DIR="$REQUESTED"
else
  WALLPAPER_DIR="$HOME/.config/omarchy/backgrounds/$REQUESTED"
fi

CURRENT_BACKGROUND_LINK="$HOME/.local/state/omarchy/current/background"

HOUR=$(date +%-H)
MINUTE=$(date +%-M)
SECOND=$(date +%-S)

if [[ ! -d "$WALLPAPER_DIR" ]]; then
  echo "dynamic-wallpaper: folder not found: $WALLPAPER_DIR" >&2
  exit 1
fi

mapfile -t IMAGES < <(
  find "$WALLPAPER_DIR" -maxdepth 1 -type f -size +0 \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
    -printf '%f\n' | sort -V
)

if ((${#IMAGES[@]} == 0)); then
  echo "dynamic-wallpaper: no images in $WALLPAPER_DIR" >&2
  exit 1
fi

# Images are used in filename order, spread evenly across the day: two images
# change every twelve hours, twenty-four change every hour. Name them so they
# sort in the order you want them to appear.
pick_for_hour() {
  echo "$WALLPAPER_DIR/${IMAGES[$(($1 * ${#IMAGES[@]} / 24))]}"
}

ensure_link() {
  mkdir -p "$(dirname "$CURRENT_BACKGROUND_LINK")"
  ln -nsf "$1" "$CURRENT_BACKGROUND_LINK"
}

set_current_background() {
  local target="$1" previous=""

  if [[ -L "$CURRENT_BACKGROUND_LINK" || -f "$CURRENT_BACKGROUND_LINK" ]]; then
    previous=$(readlink -f "$CURRENT_BACKGROUND_LINK" 2>/dev/null || true)
  fi
  [[ "$previous" == "$target" ]] && exit 0

  ensure_link "$target"
  omarchy-shell -q background setInstant "$target" >/dev/null 2>&1 || true
}

start_solar_transition() {
  local current="$1" next="$2"
  local total=$((TRANSITION_MINUTES * 60))
  local elapsed=$(((MINUTE - (60 - TRANSITION_MINUTES)) * 60 + SECOND))
  local remaining_ms progress

  ((elapsed < 0)) && elapsed=0
  ((elapsed > total)) && elapsed=$total
  remaining_ms=$(((total - elapsed) * 1000))
  ((remaining_ms < 1000)) && remaining_ms=1000

  progress=$(awk -v e="$elapsed" -v t="$total" 'BEGIN { printf "%.4f", t > 0 ? e / t : 1 }')

  ensure_link "$current"
  omarchy-shell -q background solarTransition "$current" "$next" "$progress" "$remaining_ms" >/dev/null 2>&1 || true
}

CURRENT=$(pick_for_hour "$HOUR")

if ((TRANSITION_MINUTES > 0 && TRANSITION_MINUTES < 60 && MINUTE >= 60 - TRANSITION_MINUTES)); then
  NEXT=$(pick_for_hour $(((HOUR + 1) % 24)))

  if [[ "$NEXT" != "$CURRENT" ]]; then
    start_solar_transition "$CURRENT" "$NEXT"
    exit 0
  fi
fi

set_current_background "$CURRENT"
